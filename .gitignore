# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environment
venv/
.venv/
env/

data/cache/
.cache/

# Training checkpoints (full optimizer state, can be >1GB — regeneratable).
# Adapter (~40 MB) and results.json ARE committed so teammates can run RAG /
# prompting experiments without retraining.
outputs/*/checkpoint-*/
outputs/*/runs/

# SLURM / job logs — keep logs/archive/ committed for experiment history
logs/*.out
logs/*.err
logs_extracted/

# HuggingFace cache
.huggingface/

# Zip archives
*.zip

